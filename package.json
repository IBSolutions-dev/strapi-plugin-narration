{
  "name": "strapi-plugin-narration",
  "version": "0.10.1",
  "description": "Narration for Strapi 5 (beta) — custom field + generate TTS audio into the Media Library (pluggable providers; ElevenLabs supported)",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "cms",
    "elevenlabs",
    "text-to-speech",
    "tts",
    "narration",
    "audio",
    "media-library",
    "beta"
  ],
  "homepage": "https://github.com/IBSolutions-dev/strapi-plugin-narration#readme",
  "bugs": {
    "url": "https://github.com/IBSolutions-dev/strapi-plugin-narration/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IBSolutions-dev/strapi-plugin-narration.git"
  },
  "license": "MIT",
  "author": {
    "name": "Ivars Bariss",
    "url": "https://ibsolutions.dev"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ivarsbariss"
    }
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "audit:full": "audit-ci --config audit-ci.jsonc",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "strapi-plugin build",
    "postbuild": "tsc -p shared/tsconfig.build.json",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pack:local": "npm version prerelease --preid=local --no-git-tag-version && npm run build && npm pack",
    "prepublishOnly": "npm run audit:prod && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p server/tsconfig.build.json --noEmit && tsc -p admin/tsconfig.build.json --noEmit",
    "release:preflight": "bash scripts/release-preflight.sh",
    "verify": "strapi-plugin verify",
    "watch": "strapi-plugin watch"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.42.0",
    "fs-extra": "^11.3.4",
    "undici": "^6.24.1"
  },
  "devDependencies": {
    "@strapi/admin": "5.37.1",
    "@strapi/design-system": "2.1.2",
    "@strapi/icons": "2.1.2",
    "@strapi/sdk-plugin": "^6.1.0",
    "@strapi/strapi": "5.37.1",
    "@strapi/typescript-utils": "5.37.1",
    "@strapi/upload": "5.37.1",
    "@strapi/utils": "5.45.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/use-sync-external-store": "^0.0.3",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitest/coverage-v8": "^3.2.4",
    "audit-ci": "^7.1.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.5.0",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "6.6.2",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.1.8",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.0.0",
    "yup": "0.32.9"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.1.2",
    "@strapi/icons": "^2.1.2",
    "@strapi/strapi": "^5.0.0",
    "@strapi/upload": "^5.0.0",
    "@strapi/utils": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0",
    "yup": "^0.32.9"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    },
    "styled-components": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0 <=24.x.x"
  },
  "strapi": {
    "kind": "plugin",
    "name": "narration",
    "displayName": "Narration (Beta)",
    "description": "Generate narration audio from configured fields using your configured TTS provider. Beta — APIs and config keys may change before 1.0."
  }
}
